{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "inherits": ["darwin"],
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "{CURRENT_ARCH}"
            }
        },
        {
            "name": "debug",
            "inherits": ["darwin-debug"],
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "{CURRENT_ARCH}"
            }
        },
        {
            "name": "unit-tests-debug",
            "inherits": ["darwin-unit-tests-debug"],
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "{CURRENT_ARCH}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "unit-tests-debug",
            "configurePreset": "unit-tests-debug"
        }
    ]
}
