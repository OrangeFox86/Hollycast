{
    "version": 6,
    "configurePresets": [
        {
            "name": "darwin-user-base",
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "{CURRENT_ARCH}"
            }
        },
        {
            "name": "default",
            "inherits": ["darwin-user-base", "darwin"]
        },
        {
            "name": "debug",
            "inherits": ["darwin-user-base", "darwin-debug"]
        },
        {
            "name": "unit-tests-debug",
            "inherits": ["darwin-user-base", "darwin-unit-tests-debug"]
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "unit-tests-debug",
            "configurePreset": "unit-tests-debug"
        }
    ]
}
