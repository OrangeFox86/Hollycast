{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Attach",
            "type": "cppvsdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/Debug/Hollycast.exe"
        },
        {
            "name": "(Windows) Debug Hollycast",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Hollycast.exe",
            "args": ["--config", "log:Verbosity=3", "--config", "log:LogToFile=yes"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug/",
            "environment": [],
            "console": "internalConsole",
            "preLaunchTask": "Build Debug"
        },
        {
            "name": "(Windows) Debug Unit Tests",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-unit-tests-debug/Debug/Hollycast.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-unit-tests-debug/Debug/",
            "environment": [],
            "console": "externalTerminal",
            "preLaunchTask": "Build Unit Tests (Debug)"
        },

        {
            "name": "(Linux) Attach",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build-debug/Hollycast",
            "setupCommands": [
                {
                    "description": "Ignore SIGSEGV for Dynarec",
                    "text": "handle SIGSEGV nostop noprint pass",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "(Linux) Debug Hollycast",
            "type": "cppdbg",
            "MIMode": "gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/Hollycast",
            "args": ["--config", "log:Verbosity=3", "--config", "log:LogToFile=yes"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-debug/",
            "environment": [],
            "preLaunchTask": "Build Debug",
            "setupCommands": [
                {
                    "description": "Ignore SIGSEGV for Dynarec",
                    "text": "handle SIGSEGV nostop noprint pass",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "(Linux) Debug Unit Tests",
            "type": "cppdbg",
            "MIMode": "gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build-unit-tests-debug/Hollycast",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build-unit-tests-debug/",
            "environment": [],
            "preLaunchTask": "Build Unit Tests (Debug)"
        },


        // Required extension: vadimcn.vscode-lldb
        {
            "name": "(macOS) Attach",
            "type": "lldb",
            "request": "attach",
            "program": "${workspaceFolder}/build/Debug/Hollycast.app/Contents/MacOS/Hollycast",
            "initCommands": [
                "command source ${workspaceFolder}/shell/apple/emulator-osx/LLDBInitFile"
            ]
        },
        {
            "name": "(macOS) Debug Hollycast",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/Hollycast.app/Contents/MacOS/Hollycast",
            "args": ["--config", "log:Verbosity=3", "--config", "log:LogToFile=yes"],
            "cwd": "${workspaceFolder}/build",
            "preLaunchTask": "Build Debug",
            "initCommands": [
                "command source ${workspaceFolder}/shell/apple/emulator-osx/LLDBInitFile"
            ]
        }
    ]
}
