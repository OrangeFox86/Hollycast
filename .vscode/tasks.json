{
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "cmake",
            "command": "configure",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "preset": "default",
            "problemMatcher": [],
            "hide": true,
            "options": {
                "environment": {
                    "CC": "cl.exe",
                    "CXX": "cl.exe"
                }
            }
        },
        {
            "label": "CMake: build",
            "type": "cmake",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "preset": "default",
            "problemMatcher": [],
            "dependsOn": [
                "CMake: configure"
            ]
        },
        {
            "label": "CMake: configure (Debug)",
            "type": "cmake",
            "command": "configure",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "preset": "debug",
            "problemMatcher": [],
            "hide": true,
            "options": {
                "environment": {
                    "CC": "cl.exe",
                    "CXX": "cl.exe"
                }
            }
        },
        {
            "label": "CMake: build (Debug)",
            "type": "cmake",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "preset": "debug",
            "problemMatcher": [],
            "dependsOn": [
                "CMake: configure (Debug)"
            ]
        },
        {
            "type": "shell",
            "label": "Build Debug and Copy cfg",
            "command": "cp",
            "windows": {
                "args": [
                    "${workspaceFolder}/.vscode/default_emu.cfg",
                    "./Debug/emu.cfg"
                ]
            },
            "linux": {
                "args": [
                    "${workspaceFolder}/.vscode/default_emu.cfg",
                    "./emu.cfg"
                ]
            },
            "osx": {
                "args": [
                    "${workspaceFolder}/.vscode/default_emu.cfg",
                    "./emu.cfg"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}/build-debug"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "CMake: build (Debug)"
            ]
        },
        {
            "label": "CMake: configure unit tests (Debug)",
            "type": "cmake",
            "command": "configure",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "preset": "debug-unit-tests",
            "problemMatcher": [],
            "hide": true,
            "options": {
                "environment": {
                    "CC": "cl.exe",
                    "CXX": "cl.exe"
                }
            }
        },
        {
            "label": "CMake: build unit tests (Debug)",
            "type": "cmake",
            "command": "build",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "preset": "debug-unit-tests",
            "problemMatcher": [],
            "dependsOn": [
                "CMake: configure unit tests (Debug)"
            ]
        },
        {
            "type": "shell",
            "label": "Run Unit Tests",
            "command": "./flycast",
            "args": [],
            "windows":{
                "options": {
                    "cwd": "${workspaceFolder}/build-ut/Debug"
                }
            },
            "linux":{
                "options": {
                    "cwd": "${workspaceFolder}/build-ut"
                }
            },
            "osx":{
                "options": {
                    "cwd": "${workspaceFolder}/build-ut"
                }
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "CMake: build unit tests (Debug)"
            ]
        },
        {
            "label": "Clean Build Folders",
            "type": "shell",
            "command": "rm -rf build*",
            "linux": {
                "command": "rm -rf build*/"
            },
            "osx": {
                "command": "rm -rf build*/"
            },
            "windows": {
                "command": "Get-ChildItem -Path . -Filter 'build*' -Directory | Remove-Item -Recurse -Force"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ],
    "version": "2.0.0"
}
